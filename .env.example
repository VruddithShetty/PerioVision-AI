# PerioVision AI - environment template.
# Copy to ".env" in this same folder (repository root) and replace every "change-me" value.
# .env is gitignored. Never put real secrets in code or in this file.
# Generate a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"

# ---- Mode ----
# demo       = in-memory database (mongomock), nothing persists, safe for presentations
# production = real MongoDB at MONGO_URI
DB_MODE=demo
MONGO_URI=mongodb://localhost:27017
DB_NAME=dental_prediction_db
# Only used by docker-compose.yml for the MongoDB container
MONGO_ROOT_USER=periovision_admin
MONGO_ROOT_PASSWORD=change-me

# ---- API ----
PORT=5000
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limiter store (use redis://... when running more than one worker)
REDIS_URL=memory://

# ---- Authentication ----
JWT_SECRET_KEY=change-me-64-hex-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_IDLE_MINUTES=30

# ---- Encryption & integrity ----
# AES-256-GCM keys (64 hex characters each). Either one key...
FIELD_ENCRYPTION_KEY=change-me-64-hex-chars
# ...or a key ring for rotation: the active key encrypts, older keys only decrypt.
# FIELD_ENCRYPTION_KEYS=k2:<64 hex>,k1:<64 hex>
# FIELD_ENCRYPTION_ACTIVE_KID=k2
# ...or a KMS-style JSON key file: {"active": "k2", "keys": {"k1": "...", "k2": "..."}}
# FIELD_ENCRYPTION_KEYFILE=backend/keys/field_keys.json
# HMAC key that authenticates audit-log Merkle anchors
AUDIT_ANCHOR_KEY=change-me-64-hex-chars
# Optional: a folder on storage the app server cannot rewrite (another host, WORM/object-lock mount).
# Every audit anchor is also appended there, so rolling back the local log is detectable.
# AUDIT_ANCHOR_WITNESS_DIR=
# Password protecting backend/keys/model_signing.pem (RSA-PSS signing of models and reports)
MODEL_SIGNING_PASSWORD=change-me
# Clinical approval key. A DIFFERENT secret, held by whoever clears models for use on
# patients - not by whoever builds them. If one person holds both, the separation is
# only on paper. See docs/AI_SECURITY.md.
MODEL_APPROVAL_PASSWORD=change-me-and-keep-separate

# Number of reverse proxies in front of the app. Leave at 0 when there is none:
# trusting X-Forwarded-For without a proxy lets any client forge its source IP.
TRUSTED_PROXY_COUNT=0

# ---- Optional AWS Secrets Manager ----
USE_AWS_SECRETS=false
AWS_REGION=
AWS_SECRET_NAME=

# ---- Accounts created at startup (DEMO ONLY - leave blank in production) ----
# Passwords need 10+ characters with upper- and lower-case letters and a digit.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_TECHNICIAN_EMAIL=
DEMO_TECHNICIAN_PASSWORD=
DEMO_AUDITOR_EMAIL=
DEMO_AUDITOR_PASSWORD=
# QR codes on reports point here (frontend verification page)
PUBLIC_VERIFY_URL=http://localhost:5173/verify

# Optional local HTTPS (python scripts/make_dev_cert.py creates these; paths relative to backend/)
TLS_CERT=
TLS_KEY=
