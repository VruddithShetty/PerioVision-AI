# The website (production build) served by Caddy, which also gets and renews the HTTPS certificate and forwards
# /api to the backend, so the browser sees a single origin.
FROM node:20-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /src/dist /srv
COPY deploy/server/Caddyfile /etc/caddy/Caddyfile
